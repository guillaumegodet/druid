---
// « Qui / où » box at the top of every how-to guide (template in gabarits/guide.mdx):
// required profile, menu path, and the instance capability when the feature is optional
// (profiles and capabilities: docs/documentation-utilisateur-inventaire.md §§ 2-3).
import { Aside } from '@astrojs/starlight/components';
import { STRINGS, asHelpLang } from '../lib/i18n';

interface Props {
	/** Profiles allowed, in help vocabulary (e.g. « Services centraux, administrateurs »). */
	profils: string;
	/** Path in the Druid menu (e.g. « Personnel › À traiter › Doublons »). */
	menu: string;
	/** Only for optional features (e.g. « instances reliées à un annuaire LDAP »). */
	disponibilite?: string;
}

const { profils, menu, disponibilite } = Astro.props;
// Language of the page content (a French fallback page shown under /en/ keeps French labels).
const lang = asHelpLang(Astro.locals.starlightRoute.entryMeta.lang);
const s = STRINGS[lang];
const colon = lang === 'fr' ? ' :' : ':';
---

<Aside type="note" title={s.quiOuTitle}>
	<ul class="druid-quiou">
		<li><strong>{s.profiles}{colon}</strong> {profils}</li>
		<li><strong>{s.inDruid}{colon}</strong> {menu}</li>
		{disponibilite && <li><strong>{s.availableOn}{colon}</strong> {disponibilite}</li>}
	</ul>
</Aside>

<style>
	.druid-quiou {
		list-style: none;
		padding-left: 0;
		margin: 0;
	}
</style>
