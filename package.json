{
  "name": "druid-admin",
  "private": true,
  "version": "2.11.1",
  "license": "CECILL-2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-info.cjs && node scripts/prepare-cloudflare-assets.cjs && node scripts/functions_pg_bundle.cjs && npm run build:server && npm run build:migrate && npm run build:copy && npm run build:graph && npm run build:publications && npm run build:seed && npm run build:calls && npm run build:export-calls && npm run build:collect && npm run build:theses && npm run build:eligibility && npm run build:embed-calls && vite build && node scripts/seed_demo_on_pages.cjs",
    "build:server": "esbuild server/apiV1.ts --bundle --platform=node --format=cjs --target=node20 --external:unpdf --outfile=server-api.cjs --log-level=warning",
    "preview": "vite preview",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile",
    "test": "vitest run",
    "lint:comments": "node scripts/tests/check_comments_lang.cjs --strict",
    "test:watch": "vitest",
    "merge:doublons": "mkdir -p scripts/.build && esbuild scripts/merge_doublons.ts --bundle --platform=node --format=cjs --outfile=scripts/.build/merge_doublons.cjs --log-level=warning && node scripts/.build/merge_doublons.cjs",
    "normalize:emeritus": "mkdir -p scripts/.build && esbuild scripts/normalize_emeritus.ts --bundle --platform=node --format=cjs --outfile=scripts/.build/normalize_emeritus.cjs --log-level=warning && node scripts/.build/normalize_emeritus.cjs",
    "export:abes": "mkdir -p scripts/.build && esbuild scripts/export_abes.ts --bundle --platform=node --format=cjs --external:xlsx --outfile=scripts/.build/export_abes.cjs --log-level=warning && node scripts/.build/export_abes.cjs",
    "db:migrate": "dbmate --migrations-dir db/migrations --no-dump-schema up",
    "db:rollback": "dbmate --migrations-dir db/migrations --no-dump-schema rollback",
    "db:types": "kysely-codegen",
    "test:db": "vitest run --no-file-parallelism lib/__tests__/*.integration.test.ts",
    "migrate:grist-to-pg": "npm run -s build:migrate && node scripts/.build/migrate_grist_to_pg.cjs",
    "seed:demo": "npm run -s build:seed && node scripts/.build/seed_demo_pg.cjs",
    "build:copy": "mkdir -p scripts/.build && esbuild scripts/copy_pg_to_grist.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=scripts/.build/copy_pg_to_grist.cjs --log-level=warning",
    "build:calls": "mkdir -p scripts/.build && esbuild scripts/import_calls.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=scripts/.build/import_calls.cjs --log-level=warning",
    "build:export-calls": "mkdir -p scripts/.build && esbuild scripts/export_calls.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=scripts/.build/export_calls.cjs --log-level=warning",
    "build:collect": "mkdir -p scripts/.build && esbuild scripts/collect_calls.ts --bundle --platform=node --format=cjs --external:pg-native --external:unpdf --outfile=scripts/.build/collect_calls.cjs --log-level=warning",
    "build:theses": "mkdir -p scripts/.build && esbuild scripts/sync_theses.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=scripts/.build/sync_theses.cjs --log-level=warning",
    "build:eligibility": "mkdir -p scripts/.build && esbuild scripts/compute_eligibility.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=scripts/.build/compute_eligibility.cjs --log-level=warning",
    "build:embed-calls": "mkdir -p scripts/.build && esbuild scripts/embed_calls.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=scripts/.build/embed_calls.cjs --log-level=warning",
    "build:publications": "mkdir -p scripts/.build && esbuild scripts/import_newsletter.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=scripts/.build/import_newsletter.cjs --log-level=warning",
    "build:graph": "mkdir -p scripts/.build && esbuild scripts/import_graph_snapshot.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=scripts/.build/import_graph_snapshot.cjs --log-level=warning && esbuild scripts/graph_publish.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=scripts/.build/graph_publish.cjs --log-level=warning",
    "build:functions-pg": "node scripts/functions_pg_bundle.cjs",
    "build:seed": "mkdir -p scripts/.build && esbuild scripts/seed_demo_pg.ts --bundle --platform=node --format=cjs --external:pg-native --log-override:empty-import-meta=silent --outfile=scripts/.build/seed_demo_pg.cjs --log-level=warning",
    "build:migrate": "mkdir -p scripts/.build && esbuild scripts/migrate_grist_to_pg.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=scripts/.build/migrate_grist_to_pg.cjs --log-level=warning"
  },
  "dependencies": {
    "@lingui/core": "^5.9.5",
    "@lingui/react": "^5.9.5",
    "amqplib": "^2.2.0",
    "dbmate": "^2.36.0",
    "dotenv": "^16.4.5",
    "echarts": "^6.0.0",
    "express": "^4.22.3",
    "express-session": "^1.18.1",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "kysely": "^0.29.6",
    "ldapjs": "^3.0.7",
    "lucide-react": "^1.51.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svg2pdf.js": "^2.8.1",
    "unpdf": "1.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^5.9.5",
    "@lingui/cli": "^5.9.5",
    "@lingui/vite-plugin": "^5.9.5",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "kysely-codegen": "^0.20.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.3"
  }
}
