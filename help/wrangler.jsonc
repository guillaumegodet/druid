// Cloudflare Workers (static assets only) — worker « druid-aide ».
// Workers Builds settings, production and « Previews Base » alike: root directory `help`,
// build `npm run build`, watch paths `help/*`; deploy `npx wrangler deploy` (production) and
// `npx wrangler preview` (pull-request branches). The `previews` block is required by
// `wrangler preview`: without it every branch build failed at the deploy step.
{
  "name": "druid-aide",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "previews": {}
}
