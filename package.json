{
  "name": "druid-admin",
  "private": true,
  "version": "1.7.1",
  "license": "CECILL-2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-info.cjs && node scripts/prepare-cloudflare-assets.cjs && npm run build:server && vite build",
    "build:server": "esbuild server/apiV1.ts --bundle --platform=node --format=cjs --target=node20 --outfile=server-api.cjs --log-level=warning",
    "preview": "vite preview",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile",
    "test": "vitest run",
    "lint:comments": "node scripts/tests/check_comments_lang.cjs --strict",
    "test:watch": "vitest",
    "merge:doublons": "mkdir -p scripts/.build && esbuild scripts/merge_doublons.ts --bundle --platform=node --format=cjs --outfile=scripts/.build/merge_doublons.cjs --log-level=warning && node scripts/.build/merge_doublons.cjs",
    "normalize:emeritus": "mkdir -p scripts/.build && esbuild scripts/normalize_emeritus.ts --bundle --platform=node --format=cjs --outfile=scripts/.build/normalize_emeritus.cjs --log-level=warning && node scripts/.build/normalize_emeritus.cjs",
    "export:abes": "mkdir -p scripts/.build && esbuild scripts/export_abes.ts --bundle --platform=node --format=cjs --external:xlsx --outfile=scripts/.build/export_abes.cjs --log-level=warning && node scripts/.build/export_abes.cjs",
    "db:migrate": "dbmate --migrations-dir db/migrations --no-dump-schema up",
    "db:rollback": "dbmate --migrations-dir db/migrations --no-dump-schema rollback",
    "db:types": "kysely-codegen",
    "test:db": "vitest run lib/__tests__/db.integration.test.ts"
  },
  "dependencies": {
    "@lingui/core": "^5.9.5",
    "@lingui/react": "^5.9.5",
    "dbmate": "^2.36.0",
    "dotenv": "^16.4.5",
    "echarts": "^6.0.0",
    "express": "^4.22.3",
    "express-session": "^1.18.1",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "http-proxy-middleware": "^4.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "kysely": "^0.29.6",
    "ldapjs": "^3.0.7",
    "lucide-react": "^1.51.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^5.9.5",
    "@lingui/cli": "^5.9.5",
    "@lingui/vite-plugin": "^5.9.5",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "kysely-codegen": "^0.20.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.3"
  }
}
